{
  "info": {
    "_postman_id": "831634e8-2083-5f3e-8a48-de4b3d5dd698",
    "name": "Motor de Crédito .NET 2 (recriação de teste)",
    "description": "Chamadas à **Motor de Crédito .NET 2**. **Antes de usar:** na aba *Variables* da coleção, preencha `api_key` em **Current value** com o valor de `Api__ApiKey` do `.env`. Não grave a chave em *Initial value*: esse campo vai junto se a coleção for exportada ou compartilhada.\n\n`base_url`: `http://localhost:5080` (`dotnet run --urls http://127.0.0.1:5080`); no Docker, a porta publicada com `-p`.\n\nA autenticação (`X-API-Key: {{api_key}}`) é herdada da coleção; os pedidos de erro e de saúde trocam por \"sem autenticação\" quando precisam.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-API-Key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{api_key}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Contrato de erro comum aos dois Motores: RFC 9457 (Problem Details).",
          "pm.globals.set(\"afirmarProblema\", `(function (status, codigo) {",
          "  pm.test(\"status \" + status, () => pm.response.to.have.status(status));",
          "  pm.test(\"Content-Type application/problem+json\", () =>",
          "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\"));",
          "  const corpo = pm.response.json();",
          "  pm.test(\"campos exatos: title, status, code, request_id\", () =>",
          "    pm.expect(Object.keys(corpo).sort()).to.eql([\"code\", \"request_id\", \"status\", \"title\"]));",
          "  pm.test(\"code = \" + codigo, () => pm.expect(corpo.code).to.eql(codigo));",
          "  pm.test(\"status no corpo = \" + status, () => pm.expect(corpo.status).to.eql(status));",
          "})`);"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5080",
      "type": "string"
    },
    {
      "key": "api_key",
      "value": "",
      "type": "secret"
    }
  ],
  "item": [
    {
      "name": "Rota de negócio",
      "description": "POST /api/v1/triagem: CPF ou CNPJ (e nome, para PEP). Resultado liberar, revisar ou bloquear, sempre com os motivos.",
      "item": [
        {
          "name": "CPF com nome",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/triagem",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "triagem"
              ]
            },
            "description": "CPF válido de teste, com nome (verifica PEP). O CPF volta mascarado.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"documento\": \"529.982.247-25\",\n  \"nome\": \"Fulano de Teste\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const corpo = pm.response.json();",
                  "pm.test(\"campos da resposta\", () => pm.expect(corpo).to.have.keys(\"documento\", \"tipo\", \"resultado\", \"motivos\", \"sancoes\", \"pep\", \"consultado_em\", \"fonte\"));",
                  "pm.test(\"X-Request-ID presente\", () => pm.expect(pm.response.headers.get(\"X-Request-ID\")).to.be.ok);",
                  "pm.test(\"X-Requisicao é um ULID (26 caracteres)\", () => pm.expect(pm.response.headers.get(\"X-Requisicao\")).to.match(/^[0-9A-HJKMNP-TV-Z]{26}$/));",
                  "pm.test(\"nunca o CPF completo\", () => pm.expect(pm.response.text()).to.not.include(\"52998224725\"));",
                  "pm.test(\"CPF mascarado\", () => pm.expect(corpo.documento).to.eql(\"***.982.247-**\"));",
                  "pm.test(\"PEP verificado\", () => pm.expect(corpo.pep.verificado).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "CPF sem nome (PEP não verificado)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
